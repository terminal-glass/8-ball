# 8-BALL environment profile example (C1 contract)
#
# This file documents the future runtime artifact contract. It is a repo-side
# template only. Live installers write shell-safe KEY="value" files under:
#
#   /opt/philosopher/profiles/
#
# The legacy file remains supported:
#
#   /opt/philosopher/instance.env
#
# Do not store secrets here. No Passport JWTs, license keys, Stripe secrets,
# S3 presigned URLs, or customer credentials.

# --- Schema and resolved paths -----------------------------------------------

EIGHTBALL_PROFILE_SCHEMA_VERSION="1"
EIGHTBALL_PROFILE_DIR="/opt/philosopher/profiles"
NCGPT_ROOT="/opt/philosopher"

# --- 00-instance.env (written by 0.sh or platform importer) --------------------

INSTANCE_ADDRESS="203.0.113.10"
PRIVATE_IP="10.0.0.5"
HOST_NAME="ncgpt-example"
PUBLIC_BASE_DOMAIN="203.0.113.10.nip.io"

# Legacy URL facts (also written to /opt/philosopher/instance.env)
CHAT_URL="http://203.0.113.10:3000"
WIKI_URL="http://203.0.113.10:8080"

# --- 10-platform.env (written by 8.2 or importer) --------------------------

EIGHTBALL_OS_FAMILY="linux"
EIGHTBALL_PROVIDER="aws_lightsail"
EIGHTBALL_INSTANCE_CLASS=""

# --- 20-hardware.env (written by 8.2 after measurement) ----------------------
# 8.2 measures missing facts and writes this file at install time.
# Values below are placeholders illustrating the contract, not sizing truth.

EIGHTBALL_RAM_MB=""
EIGHTBALL_CPU_THREADS=""
EIGHTBALL_DISK_FREE_GB=""
EIGHTBALL_GPU_PRESENT="unknown"
EIGHTBALL_GPU_NAME=""
EIGHTBALL_GPU_VRAM_MB=""

# --- 30-catalog.env (written by catalog pinning step) ------------------------

EIGHTBALL_CATALOG_VERSION=""
EIGHTBALL_SIZING_MANIFEST_VERSION=""

# --- 40-selection.env (written by website/auth installer or operator) --------

EIGHTBALL_SELECTED_FAMILY_ID=""
EIGHTBALL_SELECTED_MODEL_ID=""
EIGHTBALL_SELECTED_VARIANT_TAG=""
EIGHTBALL_INSTALL_MODE="unknown"

# --- 50-recommendation.env (written by 8.2; not an input file) ---------------
# EIGHTBALL_RECOMMENDED_FAMILY_ID=""
# EIGHTBALL_RECOMMENDED_MODEL_ID=""
# EIGHTBALL_RECOMMENDED_VARIANT_TAG=""
# EIGHTBALL_FALLBACK_VARIANT_TAG=""
# EIGHTBALL_RECOMMENDATION_STATUS=""
# EIGHTBALL_RECOMMENDATION_REASON_CODES=""

# --- 90-result.env (written by 8.2; read by 8.3) -----------------------------
# EIGHTBALL_RESULT_STATUS=""
# EIGHTBALL_RESULT_FAMILY_ID=""
# EIGHTBALL_RESULT_MODEL_ID=""
# EIGHTBALL_RESULT_VARIANT_TAG=""
# EIGHTBALL_RESULT_INSTALL_MODE=""
# EIGHTBALL_RESULT_MESSAGE=""
