{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal.glass/schemas/model-family.schema.json",
  "title": "ModelFamily",
  "type": "object",
  "required": ["id", "publisher_id", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "catalog_source_id": { "type": "string" },
    "publisher_id": { "type": "string" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "description": { "type": ["string", "null"] },
    "primary_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["true", "false", "unknown"]
      }
    },
    "ollama_url": { "type": ["string", "null"], "format": "uri" },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
    "provenance": { "type": "object" },
    "review_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknown_field_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_exception_retained": { "type": "boolean" }
  },
  "additionalProperties": false
}
