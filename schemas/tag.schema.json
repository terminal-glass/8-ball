{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal.glass/schemas/tag.schema.json",
  "title": "ModelTag",
  "type": "object",
  "required": ["id", "ollama_identifier", "model_id", "tag"],
  "properties": {
    "id": { "type": "string" },
    "ollama_identifier": { "type": "string" },
    "model_id": { "type": "string" },
    "tag": { "type": "string" },
    "parameter_count": { "type": ["integer", "null"], "minimum": 0 },
    "parameter_unit": { "type": ["string", "null"] },
    "quantization": { "type": ["string", "null"] },
    "architecture": { "type": ["string", "null"] },
    "context_window_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "download_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "download_size_text": { "type": ["string", "null"] },
    "installed_storage_bytes_estimated": { "type": ["integer", "null"], "minimum": 0 },
    "availability": {
      "type": "string",
      "enum": ["local", "cloud", "both", "cloud_only", "unknown"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["true", "false", "unknown"]
      }
    },
    "pull_command": { "type": ["string", "null"] },
    "run_command": { "type": ["string", "null"] },
    "alias_target": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"], "format": "uri" },
    "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
    "provenance": { "type": "object" },
    "capability_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ollama_identifier",
          "capability_id",
          "kind",
          "value",
          "source_url",
          "method",
          "runtime_version",
          "hardware",
          "limitations",
          "status"
        ],
        "properties": {
          "ollama_identifier": { "type": "string", "minLength": 1 },
          "capability_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["source_claim", "measured_test", "unknown"] },
          "value": { "enum": ["true", "false", "unknown"] },
          "source_url": { "type": ["string", "null"] },
          "method": { "type": ["string", "null"] },
          "runtime_version": { "type": ["string", "null"] },
          "hardware": { "type": ["string", "null"] },
          "limitations": { "type": ["string", "null"] },
          "status": { "enum": ["tested", "planned", "untested"] }
        },
        "additionalProperties": false
      }
    },
    "source_exception_retained": { "type": "boolean" }
  },
  "additionalProperties": false
}
