{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal.glass/schemas/component-release-manifest.schema.json",
  "title": "ComponentReleaseManifest",
  "type": "object",
  "required": [
    "schema",
    "installer_suite_version",
    "catalog_version",
    "catalog_version_independent",
    "size_unit_policy",
    "signature_policy",
    "auto_install_on_catalog_refresh",
    "default_execution_order",
    "components",
    "entry_points"
  ],
  "properties": {
    "schema": { "const": "terminal-glass.8-ball.component-release/1" },
    "installer_suite_version": { "type": "string", "minLength": 1 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "catalog_version_independent": { "const": true },
    "size_unit_policy": { "const": "decimal" },
    "signature_policy": {
      "type": "object",
      "required": ["algorithm_when_signed", "unsigned_allowed", "note"],
      "properties": {
        "algorithm_when_signed": { "const": "ed25519" },
        "unsigned_allowed": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "auto_install_on_catalog_refresh": { "const": false },
    "default_execution_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entryPoint" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "signature": {
      "type": "object",
      "required": ["status", "algorithm", "public_key_id", "value"],
      "properties": {
        "status": { "enum": ["unsigned", "signed"] },
        "algorithm": { "enum": ["ed25519", null] },
        "public_key_id": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "version",
        "platform",
        "role",
        "required",
        "dependencies",
        "source",
        "artifacts",
        "sha256",
        "signature",
        "entry_point",
        "execution_order",
        "experimental",
        "letter_suffix",
        "not_in_default_chain",
        "hardware_execution",
        "repository_tests",
        "auto_installs_models"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "string" },
        "platform": { "enum": ["any", "linux", "darwin", "windows"] },
        "role": { "enum": ["catalog", "installer", "manager", "runtime"] },
        "required": { "type": "boolean" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "source": {
          "type": "object",
          "required": ["repository", "path"],
          "properties": {
            "repository": { "type": "string" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "$ref": "#/$defs/signature" },
        "entry_point": { "type": ["string", "null"] },
        "execution_order": { "type": "array", "items": { "type": "string" } },
        "experimental": { "type": "boolean" },
        "letter_suffix": { "type": ["string", "null"] },
        "not_in_default_chain": { "type": "boolean" },
        "hardware_execution": { "enum": ["untested", "not-applicable"] },
        "repository_tests": { "enum": ["present", "mock-api", "none"] },
        "auto_installs_models": { "const": false }
      },
      "additionalProperties": false
    },
    "entryPoint": {
      "type": "object",
      "required": [
        "consumer",
        "os",
        "lane",
        "component_id",
        "entry_point",
        "execution_order",
        "hardware_execution",
        "repository_tests",
        "sha256"
      ],
      "properties": {
        "consumer": { "type": "string" },
        "os": { "enum": ["linux", "darwin", "windows"] },
        "lane": { "type": "string" },
        "component_id": { "type": "string" },
        "entry_point": { "type": "string" },
        "execution_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "hardware_execution": { "enum": ["untested", "not-applicable"] },
        "repository_tests": { "enum": ["present", "mock-api", "none"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
